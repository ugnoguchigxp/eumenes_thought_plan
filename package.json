{
	"name": "eumenes-thought-plan",
	"version": "0.3.0",
	"private": true,
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": "./src/index.ts",
		"./openai": "./standalone/openai.ts",
		"./plans/*": "./plans/*"
	},
	"files": [
		"src",
		"standalone",
		"plans",
		"mcp",
		"config/thought-plan.json",
		"LICENSE"
	],
	"scripts": {
		"verify": "bun scripts/verify.ts",
		"typecheck": "bun check",
		"lint": "bun x --bun oxlint --deny-warnings",
		"format": "bun fmt",
		"format:check": "bun fmt --check",
		"test": "bun test ./test",
		"mcp": "bun mcp/server.ts",
		"pack": "bun scripts/pack.ts",
		"examples": "zsh -l scripts/api-entry.zsh examples/run.ts",
		"examples:fixture": "bun examples/run.ts --fixture --ledger off"
	},
	"peerDependencies": {
		"openai": "7.51.0",
		"zod": "^4.4.3"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "1.31.0"
	},
	"devDependencies": {
		"@types/bun": "1.3.14",
		"openai": "7.51.0",
		"oxlint": "1.86.0",
		"typescript": "7.0.2",
		"zod": "4.4.3"
	},
	"packageManager": "bun@1.4.4",
	"peerDependenciesMeta": {
		"openai": {
			"optional": true
		}
	}
}
